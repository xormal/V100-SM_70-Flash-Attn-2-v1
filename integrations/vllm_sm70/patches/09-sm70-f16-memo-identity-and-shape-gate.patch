   const auto key = make_sm70_f16_weight_cache_key(weight);
+  const void* const src_data = weight.data_ptr();

   {
     std::lock_guard<std::mutex> lock(sm70_f16_weight_cache_mutex);
     auto it = sm70_f16_weight_cache.find(key);
